{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.json",
          "/*.css",
          "/*.js",
          "!/sw.js",
          "/icon.svg",
          "/icon-*.png",
          "/fonts/fonts.css"
        ]
      }
    },
    {
      "name": "fontes-e-vendor",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/fonts/**",
          "/vendor/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/novo/**",
    "!/health"
  ]
}
